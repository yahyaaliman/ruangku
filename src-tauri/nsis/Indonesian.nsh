; Teks Bahasa Indonesia untuk pesan khusus installer Tauri (NSIS).
; Padanan dari English.nsh milik tauri-bundler 2.x. Simpan hanya karakter ASCII.
LangString addOrReinstall ${LANG_INDONESIAN} "Tambah/pasang ulang komponen"
LangString alreadyInstalled ${LANG_INDONESIAN} "Sudah terpasang"
LangString alreadyInstalledLong ${LANG_INDONESIAN} "${PRODUCTNAME} ${VERSION} sudah terpasang. Pilih tindakan yang ingin dilakukan, lalu klik Lanjut untuk meneruskan."
LangString appRunning ${LANG_INDONESIAN} "${PRODUCTNAME} sedang berjalan. Tutup dulu (termasuk dari ikon di system tray), lalu coba lagi."
LangString appRunningOkKill ${LANG_INDONESIAN} "${PRODUCTNAME} sedang berjalan.$\nKlik OK untuk menutupnya. Data Anda sudah tersimpan otomatis."
LangString chooseHowToInstall ${LANG_INDONESIAN} "Pilih cara memasang ${PRODUCTNAME}."
LangString chooseMaintenanceOption ${LANG_INDONESIAN} "Pilih tindakan pemeliharaan yang ingin dilakukan."
LangString createDesktop ${LANG_INDONESIAN} "Buat pintasan di desktop"
LangString deleteAppData ${LANG_INDONESIAN} "Hapus juga data aplikasi (tugas, catatan, keuangan, pengaturan, dan backup)"
LangString dontUninstall ${LANG_INDONESIAN} "Jangan copot pemasangan"
LangString dontUninstallDowngrade ${LANG_INDONESIAN} "Jangan copot pemasangan (memasang versi lebih lama tanpa mencopot tidak diizinkan oleh installer ini)"
LangString failedToKillApp ${LANG_INDONESIAN} "Gagal menutup ${PRODUCTNAME}. Tutup dulu aplikasinya, lalu coba lagi."
LangString installingWebview2 ${LANG_INDONESIAN} "Memasang WebView2..."
LangString newerVersionInstalled ${LANG_INDONESIAN} "Versi ${PRODUCTNAME} yang lebih baru sudah terpasang. Memasang versi yang lebih lama tidak disarankan. Bila memang perlu, sebaiknya copot versi yang terpasang terlebih dahulu. Pilih tindakan yang ingin dilakukan, lalu klik Lanjut untuk meneruskan."
LangString older ${LANG_INDONESIAN} "lebih lama"
LangString olderOrUnknownVersionInstalled ${LANG_INDONESIAN} "Versi ${PRODUCTNAME} yang $R4 sudah terpasang di komputer ini. Disarankan mencopotnya sebelum memasang. Pilih tindakan yang ingin dilakukan, lalu klik Lanjut untuk meneruskan."
LangString silentDowngrades ${LANG_INDONESIAN} "Installer ini tidak mengizinkan pemasangan versi yang lebih lama, sehingga pemasangan senyap tidak dapat dilanjutkan. Gunakan installer dengan tampilan biasa.$\n"
LangString unableToUninstall ${LANG_INDONESIAN} "Tidak dapat mencopot pemasangan!"
LangString uninstallApp ${LANG_INDONESIAN} "Copot ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_INDONESIAN} "Copot pemasangan sebelum memasang"
LangString unknown ${LANG_INDONESIAN} "tidak dikenal"
LangString webview2AbortError ${LANG_INDONESIAN} "Gagal memasang WebView2. Aplikasi tidak dapat berjalan tanpanya. Periksa koneksi internet, lalu jalankan installer lagi."
LangString webview2DownloadError ${LANG_INDONESIAN} "Galat: gagal mengunduh WebView2 - $0"
LangString webview2DownloadSuccess ${LANG_INDONESIAN} "Bootstrapper WebView2 berhasil diunduh"
LangString webview2Downloading ${LANG_INDONESIAN} "Mengunduh bootstrapper WebView2..."
LangString webview2InstallError ${LANG_INDONESIAN} "Galat: pemasangan WebView2 gagal dengan kode $1"
LangString webview2InstallSuccess ${LANG_INDONESIAN} "WebView2 berhasil dipasang"
