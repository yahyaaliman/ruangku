{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruangku",
  "version": "0.6.0",
  "identifier": "com.ruangku.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ruangku",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; img-src 'self' blob: data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Ruangku",
    "shortDescription": "Ruangku: jadwal, tugas, catatan, keuangan, OKR, dan KPI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Indonesian"
        ],
        "customLanguageFiles": {
          "Indonesian": "nsis/Indonesian.nsh"
        },
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "startMenuFolder": "Ruangku",
        "compression": "lzma"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "copyright": "© 2026 Ruangku",
    "category": "Productivity",
    "homepage": "https://github.com/yahyaaliman/ruangku",
    "longDescription": "Ruang kerja pribadi untuk Windows: proyek, tugas, kalender, jadwal harian, rapat, kuliah, keuangan, OKR, KPI, evaluasi, catatan, file, dan ibadah. Semua data tersimpan di komputer Anda."
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true
    }
  }
}
